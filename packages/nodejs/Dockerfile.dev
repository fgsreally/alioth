FROM node:21-alpine

RUN apk --no-cache add iputils busybox-extras

# 设置工作目录
WORKDIR /usr/src/app

ENV PORT=8080
ENV WS_PORT=3000  

# 将 package.json 和 package-lock.json 复制到工作目录
COPY package*.json ./

# 安装依赖
RUN npm install

# 将应用程序代码复制到工作目录
COPY . .

# 暴露应用程序运行的端口
EXPOSE $PORT $WS_PORT 

CMD ["npm","run","start"]
